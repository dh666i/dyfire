SPARK_DATA_DIR=/data
SPARK_COOKIE_KEY_FILE=/run/secrets/cookie.key
SPARK_SESSION_KEY_FILE=/run/secrets/session.key
SPARK_WEB_BIND=0.0.0.0
SPARK_WEB_PORT=8899
SPARK_WEB_PUBLISH_IP=127.0.0.1
SPARK_SECURE_COOKIES=true
# Set true after the administrator UI is deployed to require a recent password
# step-up for role, account, subscription, redemption, mail and deployment writes.
SPARK_REQUIRE_ADMIN_STEP_UP=false
# PostgreSQL 示例（正式迁移需先完成数据回放与一致性验证）：
# SPARK_DATABASE_URL=postgresql+psycopg://dyfire:change-me@postgres:5432/dyfire
# PostgreSQL 连接池：每个进程独立计算；按 Web/Worker/Auth 进程总数和数据库上限调整。
SPARK_DATABASE_POOL_SIZE=10
SPARK_DATABASE_MAX_OVERFLOW=20
SPARK_DATABASE_POOL_TIMEOUT_SECONDS=30
SPARK_DATABASE_POOL_RECYCLE_SECONDS=1800
# Optional distributed primitives. Disabled by default; enabling this only
# prepares Redis for selected integrations and does not switch task sending.
SPARK_REDIS_ENABLED=false
# SPARK_REDIS_URL=redis://redis:6379/0
SPARK_REDIS_KEY_PREFIX=dyfire
SPARK_REDIS_SOCKET_TIMEOUT_SECONDS=1
SPARK_REDIS_CONNECT_TIMEOUT_SECONDS=1
SPARK_REDIS_MAX_CONNECTIONS=20
# 应用层请求体上限（字节）；代理层应配置更低或相同的限制。
SPARK_MAX_REQUEST_BYTES=2097152
# 可信反向代理的 IP/CIDR，逗号分隔。留空时完全忽略 X-Forwarded-*。
# 代理必须清理客户端转发头，再追加自己的 X-Forwarded-For/Proto。
SPARK_TRUSTED_PROXY_CIDRS=
# 仅在直连或可信代理报告 HTTPS 时发送 HSTS；设为 0 可关闭。
SPARK_HSTS_MAX_AGE_SECONDS=31536000
SPARK_HSTS_INCLUDE_SUBDOMAINS=false
SPARK_TIMEZONE=Asia/Shanghai
# 无端口 spark-auth 检查待登录会话的轮询间隔（秒）。
SPARK_AUTH_POLL_SECONDS=1
# spark-worker 检查待执行续火任务的轮询间隔（秒）。
SPARK_WORKER_POLL_SECONDS=10
# Optional account sharding. Run one worker per shard with the same total
# SPARK_WORKER_SHARDS and a distinct zero-based SPARK_WORKER_SHARD. Keep 0/1
# for the historical single-worker deployment. Each account is assigned by a
# stable hash and remains serialized by its account operation lease.
SPARK_WORKER_SHARD=0
SPARK_WORKER_SHARDS=1
# 发送前登录检测临时异常的恢复窗口（分钟，最小 10）。生产使用 20。
SPARK_HEALTH_RETRY_WINDOW_MINUTES=20
# 批量创建任务时每位好友错开的分钟数。
SPARK_TASK_STAGGER_MINUTES=5
SPARK_CLOCK_OFFSET_LIMIT_SECONDS=5
# systemd 基础健康检查使用的 spark-data 最小可用空间（GiB）。
SPARK_OPS_MIN_FREE_GIB=5
# WorkerLock 推算的最近心跳最大年龄（秒；不得小于 30）。
SPARK_OPS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
SPARK_BUILD_PIP_INDEX_URL=https://pypi.org/simple
