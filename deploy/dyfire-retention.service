[Unit]
Description=Dyfire bounded expired-record maintenance
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/dyfire
ExecStart=/usr/bin/docker compose --project-name douyin-spark-console --env-file /opt/dyfire/.env.console --file /opt/dyfire/compose.console.yml exec -T spark-web python -m spark_console.cli retention --apply
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
