# Use only after verifying Python dependencies and worker/database code match
# the deployed runtime. A full release build uses Dockerfile.console.
ARG DYFIRE_BASE_IMAGE
FROM ${DYFIRE_BASE_IMAGE}
COPY --chown=spark:spark spark_console/services/tasks.py /app/spark_console/services/tasks.py
COPY --chown=spark:spark VERSION /app/VERSION
COPY --chown=spark:spark spark_console/web /app/spark_console/web
COPY --chown=spark:spark spark_console/version.py /app/spark_console/version.py
COPY --chown=spark:spark spark_console/templates /app/spark_console/templates
COPY --chown=spark:spark spark_console/static /app/spark_console/static
COPY --chown=spark:spark frontend/dist /app/frontend/dist
RUN rm -f /app/spark_console/templates/tasks.html /app/spark_console/static/studio_site.css
COPY --chown=spark:spark spark_console/models.py spark_console/scheduler.py spark_console/health_retry.py spark_console/ops_monitor.py spark_console/worker.py spark_console/executor.py /app/spark_console/
COPY --chown=spark:spark spark_console/run_attempts.py /app/spark_console/
COPY --chown=spark:spark spark_console/services/account_health.py /app/spark_console/services/
COPY --chown=spark:spark core/session_health.py /app/core/
