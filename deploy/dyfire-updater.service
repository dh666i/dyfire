[Unit]
Description=Dyfire release updater
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/dyfire
Environment=DYFIRE_DEPLOY_DIR=/opt/dyfire
Environment=DYFIRE_DATA_DIR=/opt/dyfire/data
Environment=DYFIRE_GITHUB_TOKEN_FILE=/opt/dyfire/secrets/github.read.token
Environment=DYFIRE_COMPOSE_PROJECT=douyin-spark-console
Environment=DOCKER_CONFIG=/opt/dyfire/secrets/docker
ExecStart=/usr/bin/python3 /opt/dyfire/deploy/updater.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/dyfire /run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
