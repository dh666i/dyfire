# syntax=docker/dockerfile:1
# CI obtains these immutable references from deploy/runtime-images.json.
ARG WEB_RUNTIME_IMAGE
ARG BROWSER_RUNTIME_IMAGE

FROM node:26-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
COPY spark_console/static/ /spark_console/static/
RUN npm run build \
    && mkdir /font-assets \
    && mv dist/assets/*.woff2 /font-assets/

FROM node:26-bookworm-slim AS backend-source
WORKDIR /source
COPY spark_console/ ./spark_console/
RUN rm -rf spark_console/static

FROM ${WEB_RUNTIME_IMAGE} AS web
WORKDIR /app
# Stable fonts and branding remain independently reusable layers.
COPY --from=frontend --chown=spark:spark /font-assets /app/frontend/dist/assets
COPY --chown=spark:spark spark_console/static /app/spark_console/static
COPY --chown=spark:spark LICENSE /app/LICENSE
COPY --chown=spark:spark VERSION /app/VERSION
COPY --from=frontend --chown=spark:spark /frontend/dist /app/frontend/dist
COPY --chown=spark:spark core /app/core
COPY --from=backend-source --chown=spark:spark /source/spark_console /app/spark_console
COPY --chown=spark:spark utils /app/utils
USER spark
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SPARK_LOG_DIR=/tmp/spark-logs
CMD ["python", "-m", "spark_console.web.app"]

FROM ${BROWSER_RUNTIME_IMAGE} AS browser
WORKDIR /app
COPY --chown=spark:spark LICENSE /app/LICENSE
COPY --chown=spark:spark VERSION /app/VERSION
COPY --chown=spark:spark core /app/core
COPY --from=backend-source --chown=spark:spark /source/spark_console /app/spark_console
COPY --chown=spark:spark utils /app/utils
USER spark
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SPARK_LOG_DIR=/tmp/spark-logs
CMD ["python", "-m", "spark_console.worker"]

# Existing local build commands retain their execution-service default.
FROM browser AS console
