FROM node:25-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY spark_console/static/ /spark_console/static/
RUN npm run build \
    && mkdir /font-assets \
    && mv dist/assets/*.woff2 /font-assets/

FROM node:25-bookworm-slim AS backend-static
WORKDIR /source
COPY spark_console/static/ /backend-static/
# Keep the current brand assets separate from ordinary Python changes.
# Fonts are bundled once by the frontend; retired UI assets are not shipped.

FROM node:25-bookworm-slim AS backend-source
WORKDIR /source
COPY spark_console/ ./spark_console/
RUN rm -rf spark_console/static

FROM ubuntu:24.04 AS runtime

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY requirements.txt requirements-console.txt ./
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG DEBIAN_FRONTEND=noninteractive
ARG RUNTIME_REFRESH=development
USER root
RUN set -eux; \
    test -n "$RUNTIME_REFRESH"; \
      apt-get update \
      && apt-get upgrade -y \
      && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
      && python3 -m venv /opt/venv \
      && pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt -r requirements-console.txt \
      && python -m playwright install --with-deps --only-shell chromium; \
    if ! id spark >/dev/null 2>&1; then useradd --create-home --uid 10001 --user-group spark; fi; \
    chmod -R a+rX /ms-playwright; \
    rm -rf /var/lib/apt/lists/*
# The runtime is an explicit build target. Application code and version changes
# never invalidate the OS, Python or matching Chromium installation above.
FROM runtime AS console
# Font subsets are copied before application assets so ordinary JS/CSS changes
# do not download the complete Chinese font collection again.
COPY --from=frontend --chown=spark:spark /font-assets /app/frontend/dist/assets
COPY --from=backend-static --chown=spark:spark /backend-static /app/spark_console/static
COPY --chown=spark:spark LICENSE /app/LICENSE
COPY --chown=spark:spark VERSION /app/VERSION
COPY --from=frontend --chown=spark:spark /frontend/dist /app/frontend/dist
COPY --chown=spark:spark core /app/core
COPY --from=backend-source --chown=spark:spark /source/spark_console /app/spark_console
COPY --chown=spark:spark utils /app/utils
USER spark
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SPARK_LOG_DIR=/tmp/spark-logs
CMD ["python", "-m", "spark_console.web.app"]
