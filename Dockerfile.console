ARG RUNTIME_BASE=mcr.microsoft.com/dotnet/runtime-deps:8.0-noble

FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY spark_console/static/ /spark_console/static/
RUN npm run build

FROM ${RUNTIME_BASE}

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY requirements.txt requirements-console.txt ./
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG DEBIAN_FRONTEND=noninteractive
USER root
RUN set -eux; \
    if [ ! -x /opt/venv/bin/python ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
      && python3 -m venv /opt/venv \
      && pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt -r requirements-console.txt \
      && python -m playwright install --with-deps --only-shell chromium; \
    else \
      /opt/venv/bin/pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt -r requirements-console.txt; \
    fi; \
    if ! id spark >/dev/null 2>&1; then useradd --create-home --uid 10001 --user-group spark; fi; \
    chmod -R a+rX /ms-playwright; \
    rm -rf /var/lib/apt/lists/*
# The release path may reuse an older image to avoid redownloading the browser
# runtime. Remove application trees first so deleted files cannot survive as
# stale code in the incremental image.
RUN rm -rf /app/frontend/dist /app/core /app/spark_console /app/utils
COPY --chown=spark:spark LICENSE /app/LICENSE
COPY --chown=spark:spark VERSION /app/VERSION
COPY --from=frontend --chown=spark:spark /frontend/dist /app/frontend/dist
COPY --chown=spark:spark core /app/core
COPY --chown=spark:spark spark_console /app/spark_console
COPY --chown=spark:spark utils /app/utils
USER spark
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SPARK_LOG_DIR=/tmp/spark-logs
CMD ["python", "-m", "spark_console.web.app"]
